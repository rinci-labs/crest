<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
  Embedded into crest.exe by build.rs. The <msix> element links this exe to the "Crest"
  package (see package/AppxManifest.xml). Until that package is installed, Crest runs
  normally without package identity; once installed, Windows grants identity so message
  notifications can be read.
-->
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">
  <assemblyIdentity version="0.1.0.0" name="Crest.App" type="win32" processorArchitecture="amd64"/>
  <msix xmlns="urn:schemas-microsoft-com:msix.v1"
        publisher="CN=Crest Local"
        packageName="Crest"
        applicationId="App"/>
  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 10 and 11 -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}"/>
    </application>
  </compatibility>
</assembly>
